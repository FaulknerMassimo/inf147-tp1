{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug tp1.exe (Wine)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tp1.exe",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerServerAddress": "localhost:12345",
            "preLaunchTask": "Start tp1.exe under winedbg",
            "postDebugTask": "Stop winedbg",
            "setupCommands": [
                { "text": "set debuginfod enabled off" },
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]
}
